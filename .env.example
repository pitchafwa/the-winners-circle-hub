# Copy this file to .env (same folder) and fill in real values.
# .env is git-ignored — these never get committed.

# Only needed to unlock 2018-2023 league history, which ESPN hides behind
# auth for seasons that old. Get both values from your browser while logged
# into fantasy.espn.com — see league-hub project chat for the walkthrough.
ESPN_S2=
SWID=
